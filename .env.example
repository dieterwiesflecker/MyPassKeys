# ============================================================================
# MyPassKeys environment file
# ----------------------------------------------------------------------------
# Copy this file to `.env` (never commit `.env` — it is gitignored) and fill in
# the values. Docker Compose reads this file automatically for ${...} interpolation,
# and MyPassKeys reads it for BOTH local development and production:
#
#   Local:       docker compose -f compose.yaml up --build
#   Production:  docker compose -f compose.yaml -f compose.prod.yaml up -d   (via ./deploy.sh)
#
# This file is the SINGLE source of configuration for the Docker path — you do not
# need to edit appsettings.json. (A standalone `dotnet run` instead uses
# appsettings.Development.json and does NOT read this file — see README → Configuration.)
#
# The default values below are enough to run LOCALLY as-is. Lines marked
# "REQUIRED IN PRODUCTION" must be changed before you deploy to a real host.
# ============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=mypasskeys
POSTGRES_DB=mypasskeys
# REQUIRED IN PRODUCTION: use a strong, unique password.
POSTGRES_PASSWORD=mypasskeys

# --- Redis ------------------------------------------------------------------
# REQUIRED IN PRODUCTION: use a strong, unique password. Leave empty for no password (local only).
REDIS_PASSWORD=mypasskeys

# --- Outbound email (verification codes), via Resend (https://resend.com) ----
# Optional locally (codes are logged instead of sent when the key is empty).
# Required if you want verification emails to actually send.
RESEND_API_KEY=
# A sender address verified in your Resend account (e.g. noreply@yourdomain.com).
RESEND_FROM_EMAIL=noreply@example.com

# --- Key-encryption key (KEK) -----------------------------------------------
# Encrypts every tenant's JWT signing key at rest. The app refuses to start without one.
# Local: leave EMPTY — compose.yaml falls back to a built-in dev key so local just works.
# REQUIRED IN PRODUCTION: generate one and BACK IT UP securely, outside the database:
#     openssl rand -base64 32
# Losing it makes all signing keys unrecoverable. (./deploy.sh generates one on the
# server if this is empty.)
KEY_ENCRYPTION_KEY=

# Previous KEK — leave EMPTY normally. Only set during a key rotation (see DEPLOYMENT.md).
PREVIOUS_KEY_ENCRYPTION_KEY=

# --- Deployment identity ----------------------------------------------------
# DEPLOYMENT_HOST: the public host:port this install answers on. The host-gate 404s any
#   other host. Locally this is localhost:8080 (the port compose publishes). In production
#   it is your real hostname (no port), e.g. auth.example.com.
# ISSUER_BASE_URL: base for per-tenant token issuers ({base}/t/{tenantId}). Keep it STABLE
#   for the life of your tenants — resource servers reconstruct issuers from it.
# BOOTSTRAP_OWNER_EMAIL: the account guaranteed to hold tenantadmin in the management tenant
#   (so you can always log back into the admin portal). Re-applied on every startup.
# BOOTSTRAP_MANAGEMENT_ORIGIN: the browser origin of your admin portal frontend, seeded onto
#   the management tenant on first startup only (default is the Vite dev server).
#
# REQUIRED IN PRODUCTION: set DEPLOYMENT_HOST, ISSUER_BASE_URL and BOOTSTRAP_OWNER_EMAIL to real values.
DEPLOYMENT_HOST=localhost:8080
ISSUER_BASE_URL=http://localhost:8080
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_MANAGEMENT_ORIGIN=http://localhost:5173

# --- Management tenant JWT identity (first startup only) --------------------
# Issuer/audience seeded onto the management tenant the first time it is created (like the
# origin above, ignored once the tenant exists — change it later via PUT /tenants/{id}).
# The audience is what your admin-portal API validates tokens against. If left empty the app
# derives defaults from DEPLOYMENT_HOST (https://<host> / api://<host>).
BOOTSTRAP_MANAGEMENT_ISSUER=http://localhost:8080/management
BOOTSTRAP_MANAGEMENT_AUDIENCE=api://localhost:8080/management

BOOTSTRAP_SERVER_NAME=PasskeysApp
