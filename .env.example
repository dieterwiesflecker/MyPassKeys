# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# On a server, this file sits next to compose.yaml / compose.prod.yaml and Docker Compose
# reads it automatically for ${...} interpolation.

# --- PostgreSQL ---
POSTGRES_USER=mypasskeys
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mypasskeys

# --- Redis ---
# Leave empty for no password (local only); set a strong password in production.
REDIS_PASSWORD=change-me-strong-redis-password

# --- Outbound email (verification codes), via Resend (https://resend.com) ---
# Optional locally; required if you want email verification to actually send.
RESEND_API_KEY=

# --- Key-encryption key (KEK) ---
# REQUIRED. Encrypts every tenant's JWT signing key at rest. The app refuses to start without it.
# Generate with:  openssl rand -base64 32
# Losing this makes all signing keys unrecoverable — back it up securely, out of the database.
KEY_ENCRYPTION_KEY=

# Previous KEK — leave EMPTY normally. Only set during a key rotation (see DEPLOYMENT.md).
PREVIOUS_KEY_ENCRYPTION_KEY=

# --- Deployment identity (REQUIRED in production; consumed by compose.prod.yaml) ---
# DEPLOYMENT_HOST: public hostname this install answers on (host-gate 404s anything else).
# ISSUER_BASE_URL: base for per-tenant token issuers ({base}/t/{id}); keep stable for the life
#   of your tenants. BOOTSTRAP_OWNER_EMAIL: account guaranteed tenantadmin in the management tenant.
DEPLOYMENT_HOST=auth.example.com
ISSUER_BASE_URL=https://auth.example.com
BOOTSTRAP_OWNER_EMAIL=owner@example.com
