<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishAot>false</PublishAot>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- ReadyToRun: pre-compiles IL to native code at publish time.
             Faster startup and lower JIT overhead at runtime, with no AOT incompatibility risk. -->
        <PublishReadyToRun>true</PublishReadyToRun>
        <!-- Trim unused framework code to reduce image size.
             TrimmerRootDescriptor or suppress warnings if trimming causes issues with Marten/Fido2. -->
<!--        <PublishTrimmed>true</PublishTrimmed>
        <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
        <TrimmerRootAssembly Include="Marten" />
        <TrimmerRootAssembly Include="Weasel.Postgresql" />

        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>-->
<!--
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsPreviewNamespaces>
-->
    </PropertyGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="MyPassKeys.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fido2" Version="4.0.1" />
        <PackageReference Include="Fido2.AspNet" Version="4.0.1" />
        <PackageReference Include="Fido2.Models" Version="4.0.1" />
        <PackageReference Include="Marten" Version="9.30.0" />
        <PackageReference Include="Marten.AspNetCore" Version="9.30.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <!-- Pinned above the transitive 2.0.0 to patch GHSA-v5pm-xwqc-g5wc (circular schema
             reference DoS in OpenAPI parsing; fixed in 2.7.5). Must stay on the 2.x line:
             Microsoft.AspNetCore.OpenApi 10.0.9 is built against Microsoft.OpenApi 2.x, and 3.x
             makes IOpenApiMediaType.Example read-only, which breaks its source generator. -->
        <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
        <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <Content Remove="Migrations\**" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Migrations\**" />
      <Compile Remove="AppDbContext.cs" />
      <Compile Remove="DbInitializer.cs" />
      <Compile Remove="Fido2EfDbService.cs" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Migrations\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Migrations\**" />
    </ItemGroup>

</Project>
